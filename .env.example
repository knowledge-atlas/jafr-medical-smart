# انسخ هذا الملف إلى .env (ولا ترفعه إلى git — موجود في .gitignore)
# مفتاح للتطوير المحلي فقط. لا تضع مفتاحاً حقيقياً هنا لإصدار الإنتاج:
# متغيرات EXPO_PUBLIC_* تُضمَّن داخل الحزمة ويمكن استخراجها.
# في الإنتاج يُدخل المستخدم مفتاحه من: الإعدادات ← الذكاء الاصطناعي.
EXPO_PUBLIC_AI_API_KEY=

# ── فتح المالك (Owner Unlock) ──
# تجزئة الرقم السري للمالك (وليس الرقم نفسه). القيمة أدناه = الرقم الافتراضي 123456 للتطوير فقط.
# ⚠️ غيّر الرقم الافتراضي 123456 قبل النشر: node scripts/make-owner-pin-hash.mjs <رقمك_6_أرقام>
# ثم ضع الناتج هنا. في نسخة الإنتاج تُعطَّل الميزة تلقائياً إن بقيت القيمة الافتراضية أو فارغة.
EXPO_PUBLIC_OWNER_PIN_HASH=9e86b96846dd911d1c2f4e68fd21499f2e2c98e646bbad027548e201d172280e

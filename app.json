    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0a1628"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "2ec2fcee-238f-4cdc-8ae5-b6e24a2037d6"
